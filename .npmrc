# peerDependencies 를 자동 설치하지 않는다.
# 라이브러리 개발 중 소비자 환경(peer 미설치)을 그대로 재현하기 위함이다.
auto-install-peers=false

# 워크스페이스 내부 패키지는 항상 workspace: 프로토콜로 연결한다.
link-workspace-packages=true
prefer-workspace-packages=true

# 엄격한 node_modules 구조 유지 (유령 의존성 방지).
# 패키지가 선언하지 않은 의존을 import 하면 즉시 깨지도록 한다.
shamefully-hoist=false
