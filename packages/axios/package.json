{
  "name": "@txstack/axios",
  "version": "0.1.0",
  "description": "Thin axios policy layer — injectable auth, 401 handling, response envelope unwrapping, logging hooks",
  "keywords": [
    "axios",
    "http",
    "api",
    "client",
    "rest",
    "interceptor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code7004/txstack.git",
    "directory": "packages/axios"
  },
  "homepage": "https://github.com/code7004/txstack/tree/main/packages/axios#readme",
  "bugs": "https://github.com/code7004/txstack/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./singleton": {
      "types": "./dist/singleton.d.ts",
      "import": "./dist/singleton.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "axios": ">=1.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
