{
  "name": "@txstack/hooks",
  "version": "0.1.0",
  "description": "General-purpose React hooks — object state, safe polling, URL query as state",
  "keywords": [
    "react",
    "hooks",
    "url",
    "query",
    "polling"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code7004/txstack.git",
    "directory": "packages/hooks"
  },
  "homepage": "https://github.com/code7004/txstack/tree/main/packages/hooks#readme",
  "bugs": "https://github.com/code7004/txstack/issues",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./useObjectState": {
      "types": "./dist/useObjectState.d.ts",
      "import": "./dist/useObjectState.js"
    },
    "./useUrlQuery": {
      "types": "./dist/useUrlQuery.d.ts",
      "import": "./dist/useUrlQuery.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-router-dom": ">=6"
  },
  "peerDependenciesMeta": {
    "react-router-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
