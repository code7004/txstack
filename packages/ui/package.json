{
  "name": "@txstack/ui",
  "version": "0.0.0",
  "description": "Tx* React UI components — CSS custom property tokens, works with any consumer styling approach",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "css-variables",
    "dark-mode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code7004/txstack.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/code7004/txstack/tree/main/packages/ui#readme",
  "bugs": "https://github.com/code7004/txstack/issues",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aggrid": {
      "types": "./dist/aggrid.d.ts",
      "import": "./dist/aggrid.js"
    },
    "./daypicker": {
      "types": "./dist/daypicker.d.ts",
      "import": "./dist/daypicker.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.9",
    "react-day-picker": "^10.0.1"
  },
  "peerDependencies": {
    "ag-grid-community": "^35.0.0",
    "ag-grid-react": "^35.0.0",
    "react": ">=18",
    "react-day-picker": "^10.0.0",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "ag-grid-community": {
      "optional": true
    },
    "ag-grid-react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
