{
  "name": "txstack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable React library set \u2014 UI components, hooks, route metadata, HTTP client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code7004/txstack.git"
  },
  "homepage": "https://github.com/code7004/txstack#readme",
  "bugs": "https://github.com/code7004/txstack/issues",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "storybook:dev": "pnpm --filter @txstack/storybook dev",
    "storybook:build": "pnpm --filter @txstack/storybook build",
    "lint": "eslint packages apps --no-error-on-unmatched-pattern",
    "lint:fix": "eslint packages apps --fix --no-error-on-unmatched-pattern",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm build && changeset publish",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "axios": "^1.19.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
