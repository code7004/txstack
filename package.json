{
  "name": "txstack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reusable React library set — UI components, hooks, route metadata, HTTP client",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code7004/txstack.git"
  },
  "homepage": "https://github.com/code7004/txstack#readme",
  "bugs": "https://github.com/code7004/txstack/issues",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "24.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r build",
    "dev": "pnpm dev:playground",
    "dev:playground": "pnpm --filter @txstack/playground dev",
    "dev:storybook": "pnpm --filter @txstack/storybook dev",
    "build:storybook": "pnpm --filter @txstack/storybook build",
    "lint": "eslint packages apps --no-error-on-unmatched-pattern",
    "lint:fix": "eslint packages apps --fix --no-error-on-unmatched-pattern",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.1",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "axios": "^1.19.0",
    "dayjs": "^1.11.23",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^13.1.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.3",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "storybook": "^10.5.9",
    "tsup": "^8.5.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^3"
  }
}
